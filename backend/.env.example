# Path to processed advisory CSV (optional; defaults to data/processed/advisory_dataset.csv)
# ADVISORY_DATASET_PATH=

# Open-Meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=20

# Oryx agent (Gemini) — used when online
GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
# Force mode for testing: online | offline (empty = auto-detect)
# VISION_FORCE_MODE=

# Freemium cloud limit (prompts/day for free tier when Supabase usage is used)
FREE_DAILY_PROMPT_LIMIT=10

# Supabase = PostgreSQL + Auth + API (cloud)
# 1) Create a project at https://supabase.com
# 2) Run supabase/schema.sql in the SQL Editor
# 3) Paste URL + service role key (backend only — never ship service role to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
