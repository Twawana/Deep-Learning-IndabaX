# Path to processed advisory CSV (optional fallback when Supabase is off/unreachable)
# ADVISORY_DATASET_PATH=

# Data source: auto | supabase | csv
DATA_SOURCE=auto
# Auth source: auto | supabase | local  (defaults to DATA_SOURCE)
# AUTH_SOURCE=auto

# CORS — comma-separated origins allowed to call the API (Vercel + local Vite)
# Example: https://your-app.vercel.app,https://your-app-git-main.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Open-Meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_TIMEOUT_SECONDS=20

# In Vision / Oryx agent (Gemini) — used when online
GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
ASSISTANT_NAME=In Vision
# Force mode for testing: online | offline (empty = auto-detect)
# VISION_FORCE_MODE=

# Freemium cloud limit (prompts/day for free tier when Supabase usage is used)
FREE_DAILY_PROMPT_LIMIT=10

# Supabase = PostgreSQL + Auth + API (cloud)
# 1) Create a project at https://supabase.com
# 2) Run supabase/schema.sql in the SQL Editor
# 3) Paste URL + service role key (backend only — never ship service role to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# Tables
# range_sites        ← advisory / Lacuna (+ optional merged synthetic)
# range_landsites    ← synthetic survey (mapped at runtime)
# users              ← app accounts
SUPABASE_TABLE_RANGE_SITES=range_sites
SUPABASE_TABLE_RANGE_LANDSITES=range_landsites
SUPABASE_TABLE_USERS=users
